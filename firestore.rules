rules_version = '2';
// Each learner can only read and write their own document: users/{uid}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'displayName', 'updatedAt'])
        && request.resource.data.progress is map
        && request.resource.data.progress.xp is number
        && request.resource.data.progress.xp >= 0;
    }
    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
